# Loaded by systemd EnvironmentFile, not automatically by Python.
CAMDASH_CONFIG=%h/.camdash/config.yaml
CAMDASH_LOG_LEVEL=INFO

# Optional Anthropic analysis
ANTHROPIC_API_KEY=

# Optional email alerts
CAMDASH_ALERT_EMAIL=
CAMDASH_ALERT_FROM_EMAIL=
CAMDASH_ALERT_SMTP_HOST=smtp.gmail.com
CAMDASH_ALERT_SMTP_PORT=587
CAMDASH_ALERT_SMTP_SSL=false
CAMDASH_ALERT_SMTP_USER=
CAMDASH_ALERT_SMTP_PASSWORD=
